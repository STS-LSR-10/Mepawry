# ============================================================
# Environment Variables Template — Paw Memorial
# Copy this file to .env.local and fill in your keys
# ============================================================

# Database (Supabase PostgreSQL / Neon)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Auth & Realtime
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (Payments) - Test Mode Keys First!
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email (Resend)
RESEND_API_KEY="re_..."
EMAIL_FROM="Paw Memorial <noreply@yourdomain.com>"

# Cloudflare Images / Storage (Optional)
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_IMAGES_API_TOKEN=""
CLOUDFLARE_ACCOUNT_HASH=""
