// Cloudflare Workers config for Mepawry (built by @opennextjs/cloudflare).
// Secrets (SUPABASE_SERVICE_ROLE_KEY etc.) are not kept here: set them with `npx wrangler secret put NAME`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mepawry",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "mepawry" }],
  // Workers AI: translates epitaphs, guestbook notes and board posts (lib/translate.ts)
  "ai": { "binding": "AI" },
  // Public settings (not secrets). keep_vars: deploys leave variables set in the dashboard alone
  "keep_vars": true,
  "vars": { "GOOGLE_CLIENT_ID": "765592068822-3rjobs1k0ubkqea42tss9igfo7uo1bl2.apps.googleusercontent.com", "CF_ACCESS_TEAM": "patient-sky-98cd.cloudflareaccess.com" },
  // The site's own domain (registered with Cloudflare); the workers.dev address keeps working too
  "workers_dev": true,
  "routes": [
    { "pattern": "mepawry.com", "custom_domain": true },
    { "pattern": "www.mepawry.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
